# Optional build defaults; used only when passed with --env.
# Occupied disks require explicit console erase confirmation; active disks are refused.
MIN_DISK_GIB=50
MAX_DISK_GIB=80
# Space-separated global pools; no forced priority.
NTP_POOLS="2.pool.ntp.org 0.pool.ntp.org 1.pool.ntp.org 3.pool.ntp.org"
# Optional Linux username. Empty means prompt at VM boot.
USERNAME=
# Optional single-line PUBLIC SSH key. Empty means prompt for a GitHub username
# at VM boot; press Enter to skip SSH keys. Never enter a private key.
# Supplying account defaults personalizes the ISO; omit them for public builds.
SSH_KEY=

# Optional installed-system ttyS0 console at 115200 baud alongside tty0.
# The live installer retains Fedora defaults; use the normal VM console.
SERIAL_CONSOLE=false
